{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofloop/baseline-pin.schema.json",
  "title": "Proof Loop external acceptance and Run Card pin",
  "type": "object",
  "required": ["schema_version", "acceptance_tests"],
  "properties": {
    "schema_version": {"const": 1},
    "acceptance_tests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "approved_run_card_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
