{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofloop/capabilities.schema.json",
  "title": "Proof Loop capability registry",
  "type": "object",
  "required": [
    "schema_version",
    "selection_order",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "selection_order": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "policy"
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": [
        "evidence",
        "health_check",
        "id",
        "license_status",
        "lifecycle",
        "not_for",
        "policy",
        "telemetry_status",
        "use_when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "discovered",
            "reviewed",
            "installed",
            "authenticated",
            "tested",
            "enabled"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "use_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "health_check": {
          "type": "string",
          "minLength": 1
        },
        "license_status": {
          "type": "string"
        },
        "telemetry_status": {
          "type": "string"
        },
        "version_or_pin": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "enum": [
            "allow",
            "deny",
            "review"
          ]
        },
        "rollback": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_reviewed": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
