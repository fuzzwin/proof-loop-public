{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzwin/proof-loop-public/schemas/harness-task.schema.json",
  "title": "Proof Loop general task contract v1",
  "description": "Runtime validation additionally enforces normalized declared paths, disjoint edit/protection sets, protected requirements/tests, and both check purposes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "files",
    "editable",
    "protected",
    "requirements",
    "checks",
    "specialists",
    "limits",
    "host"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "criterion",
              "adapter",
              "path",
              "assertions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "purpose": {
                "enum": [
                  "verification",
                  "validation"
                ]
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "adapter": {
                "const": "json-equals"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pointer",
                    "equals"
                  ],
                  "properties": {
                    "pointer": {
                      "type": "string"
                    },
                    "equals": {}
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "criterion",
              "adapter",
              "path",
              "contains",
              "excludes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "purpose": {
                "enum": [
                  "verification",
                  "validation"
                ]
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "adapter": {
                "const": "text"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "contains": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "excludes": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "criterion",
              "adapter",
              "start_dir",
              "pattern"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "purpose": {
                "enum": [
                  "verification",
                  "validation"
                ]
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "adapter": {
                "const": "python-unittest"
              },
              "start_dir": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "criterion",
              "adapter",
              "argv",
              "controls",
              "coverage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "purpose": {
                "enum": [
                  "verification",
                  "validation"
                ]
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "adapter": {
                "const": "command-json"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "controls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "coverage": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              }
            }
          }
        ]
      }
    },
    "specialists": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instructions",
          "when"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "quality_failure",
                "verification_failure"
              ]
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_repairs",
        "max_agent_calls",
        "agent_timeout_seconds",
        "check_timeout_seconds",
        "max_run_seconds"
      ],
      "properties": {
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_agent_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "agent_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "check_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_run_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      }
    },
    "host": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "codex"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "argv",
            "controls"
          ],
          "properties": {
            "kind": {
              "const": "command"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "controls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          }
        }
      ]
    }
  }
}
