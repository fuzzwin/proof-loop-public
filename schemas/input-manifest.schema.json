{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofloop/input-manifest.schema.json",
  "title": "Proof Loop per-run input and frozen acceptance manifest",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "inputs",
    "acceptance_tests"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "$ref": "#/$defs/fileMap"
    },
    "acceptance_tests": {
      "$ref": "#/$defs/fileMap"
    }
  },
  "$defs": {
    "fileMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
