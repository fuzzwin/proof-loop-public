{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofloop/run-card.schema.json",
  "title": "Proof Loop Run Card",
  "type": "object",
  "required": [
    "acceptance_test_files",
    "assumptions",
    "capabilities_excluded",
    "capabilities_selected",
    "capability_decisions",
    "created_at",
    "done_when",
    "goal",
    "human_decision_required",
    "input_files",
    "playbook",
    "repair_rounds_allowed",
    "required_checks",
    "risk",
    "run_id",
    "schema_version",
    "scope",
    "selection_order_applied",
    "verification_mode",
    "worker_limit",
    "baseline_pin_sha256",
    "selection_metadata_not_evaluated",
    "acceptance_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "playbook": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "capabilities_selected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities_excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_decision_required": {
      "type": "boolean"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_test_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "repair_rounds_allowed": {
      "const": 2
    },
    "worker_limit": {
      "const": 3
    },
    "verification_mode": {
      "type": "string"
    },
    "capability_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "policy",
          "lifecycle",
          "reason"
        ]
      }
    },
    "selection_order_applied": {
      "type": "array",
      "prefixItems": [
        {
          "const": "policy"
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "baseline_pin_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_metadata_not_evaluated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_mode": {
      "enum": [
        "acceptance_required",
        "advisory"
      ]
    }
  },
  "additionalProperties": true
}
